---
import PageLayout from '@/layouts/PageLayout.astro';

const oils = [
  {
    "name": "Моторное масло для автомобилей HND 0W-30, 1л",
    "article": "082W99T1HD",
    "imageUrl": "https://cdn.alexsab.ru/pages/vgv/oil/hnd-0w30-1l.webp",
    "description": "Высококачественное синтетическое моторное масло HND 0W-30 соответствует стандартам API SP, ACEA C2, разработано для бензиновых двигателей легковых автомобилей, оснащенных системами доочистки выхлопных газов. Протестировано и рекомендовано для двигателей автомобилей VGV.",
    "ozonUrl": "https://ozon.ru/t/NqKDWPB"
  },
  {
    "name": "Моторное масло для автомобилей HND 5W-30, 1л",
    "article": "082W99D1HD",
    "imageUrl": "https://cdn.alexsab.ru/pages/vgv/oil/hnd-5w30-1l.webp",
    "description": "Высококачественное синтетическое моторное масло HND 5W-30 соответствует стандартам API SP, ILSAC GF-6A, ACEA C3, разработано для бензиновых двигателей легковых автомобилей, оснащенных системами доочистки выхлопных газов. Протестировано и рекомендовано для двигателей автомобилей VGV.",
    "ozonUrl": "https://ozon.ru/t/YeMEMXr"
  },
  {
    "name": "Моторное масло для автомобилей HND 5W-30, 4л",
    "article": "082W99D4HD",
    "imageUrl": "https://cdn.alexsab.ru/pages/vgv/oil/hnd-5w30-4l.webp",
    "description": "Высококачественное синтетическое моторное масло HND 5W-30 соответствует стандартам API SP, ILSAC GF-6A, ACEA C3, разработано для бензиновых двигателей легковых автомобилей, оснащенных системами доочистки выхлопных газов. Протестировано и рекомендовано для двигателей автомобилей VGV.",
    "ozonUrl": "https://ozon.ru/t/JZGmz4G"
  },
  {
    "name": "Моторное масло для автомобилей HND 0W-30, 4л",
    "article": "082W99T4HD",
    "imageUrl": "https://cdn.alexsab.ru/pages/vgv/oil/hnd-0w30-4l.webp",
    "description": "Высококачественное синтетическое моторное масло HND 0W-30 соответствует стандартам API SP, ACEA C2, разработано для бензиновых двигателей легковых автомобилей, оснащенных системами доочистки выхлопных газов. Протестировано и рекомендовано для двигателей автомобилей VGV.",
    "ozonUrl": "https://ozon.ru/t/jEjaq1"
  }
];
---

<PageLayout
    h1="Масла"
    title="Масла"
    description="Узнайте все о маслах для VGV"
    breadcrumb={[{name:"Масла",href:""}]}
>
    <p class="mb-10">Оригинальные масла разрабатываются с учетом особенностей каждой модели и проходят испытания, чтобы продлить жизнь вашему двигателю.</p>
    
    <h2 class="text-2xl font-bold mb-8">Масла для моделей U70PRO и U75PLUS</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-fr">
        {oils.map((oil) => (
            <div class="shadow-lg rounded-lg overflow-hidden flex flex-col h-full">
                <div class="w-full h-64 overflow-hidden bg-gray-50 flex items-center justify-center">
                    <img 
                        src={oil.imageUrl} 
                        alt={oil.name} 
                        class="max-w-xs h-full object-contain p-4"
                    />
                </div>
                <div class="p-6 flex flex-col grow">
                    <h3 class="font-bold text-lg mb-2">{oil.name}</h3>
                    <p class="text-sm text-gray-600 mb-3">Артикул: {oil.article}</p>
                    <p class="text-sm text-gray-700 mb-6 grow">{oil.description}</p>
                    <a 
                        href={oil.ozonUrl} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="bg-accent-500 hover:bg-accent-600 text-white font-bold py-3 px-6 rounded-lg text-center transition-colors duration-300 no-underline"
                    >
                        Купить на Ozon
                    </a>
                </div>
            </div>
        ))}
    </div>
    <br />
    <br />
    <br />
    <h2 class="text-2xl font-bold mb-8">Жидкость трансмиссионная ATF SS VIII-L для модели U75PLUS</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-fr">
        <div class="shadow-lg rounded-lg overflow-hidden flex flex-col h-full">
            <div class="w-full h-64 overflow-hidden bg-gray-50 flex items-center justify-center">
                <img 
                    src="https://cdn.alexsab.ru/pages/vgv/oil/ATF-SS-VIII-L.webp"
                    alt="Жидкость трансмиссионная ATF SS VIII-L"
                    class="max-w-xs h-full object-contain p-4"
                />
            </div>
            <div class="p-6 flex flex-col grow">
                <h3 class="font-bold text-lg mb-2">Жидкость трансмиссионная ATF SS VIII-L</h3>
                <p class="text-sm text-gray-700 mb-6 grow">Жидкость трансмиссионная ATF SS VIII-L для автомобилей VGV U75PLUS. В продаже у официальных дилеров.</p>
            </div>
        </div>
    </div>
    
</PageLayout>