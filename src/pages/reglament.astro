---
import PageLayout from '@/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
---

<PageLayout
    h1="Регламент ТО"
    title="Регламент ТО"
    description="Ознакомьтесь с Регламентом ТО к автомобилям VGV"
    breadcrumb={[{name:"Регламент ТО",href:""}]}
>
    <p class="text-center">
        <img class="md:max-w-[50%]!" src="https://cdn.alexsab.ru/pages/vgv/reglament/thumb.webp" alt="Регламент ТО">
    </p>
    <h3 class="text-center">U70PRO и U75PLUS</h3>
        <a href="https://cdn.alexsab.ru/pages/vgv/reglament/reglament_to.pdf" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 w-full justify-center text-blue-600 hover:text-blue-800 transition-colors">
            <Icon name="mdi:download" class="w-6 h-6" />
            <span>Скачать Регламент ТО</span>
        </a>
    
</PageLayout>